{
  "name": "Servico",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "duracao_minutos": {
      "type": "number",
      "default": 50
    },
    "valor": {
      "type": "number"
    },
    "categoria": {
      "type": "string"
    },
    "cor": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome",
    "clinica_id"
  ],
  "rls": {
    "create": {
      "data.clinica_id": "{{user.data.clinicId}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.clinica_id": "{{user.data.clinicId}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.clinica_id": "{{user.data.clinicId}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.clinica_id": "{{user.data.clinicId}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}