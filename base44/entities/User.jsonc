{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "description": "Se true, o usu\u00e1rio deve redefinir a senha no pr\u00f3ximo logon"
    },
    "login_provider": {
      "type": "string",
      "description": "Provedor de autentica\u00e7\u00e3o: email, google, microsoft"
    }
  }
}